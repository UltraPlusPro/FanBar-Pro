<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.fanbar.helper</string>
    <key>BundleProgram</key>
    <string>Contents/Library/LaunchServices/local.fanbar.helper</string>
    <key>MachServices</key>
    <dict>
        <key>local.fanbar.helper</key>
        <true/>
    </dict>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>local.fanbar.app</string>
    </array>
    <!-- 1.1.10 hardening: launchd restarts a crashed or watchdog-exited helper
         immediately, but never in a tight loop; a wedged process is given five
         seconds to exit before launchd escalates. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ExitTimeOut</key>
    <integer>5</integer>
</dict>
</plist>
